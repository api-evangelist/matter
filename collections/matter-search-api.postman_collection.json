  "item": [
    {
      "id": "4a3c674e-d5ab-4ef5-a506-b8308c5c18e6",
      "name": "Search",
      "description": {
        "content": "Full-text search across Matter.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "0ad16e26-db92-41cd-9041-8a9b19388b8d",
          "name": "Search",
          "request": {
            "name": "Search",
            "description": {
              "content": "Full-text search across Matter. Results are grouped\nby type, each with independent pagination. Request one or more\ntypes and get back a keyed object with a paginated list per type.\n\nCurrently supported types: `items`. More types (annotations,\nauthors) will be added in the future.\n\nSupports search operators:\n- `\"exact phrase\"` — required phrase match\n- `-excluded` — exclude term\n- `by:author` — filter by author or publisher name\n- `site:domain` — filter by domain\n- `title:word` — match in title only\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "(Required) Search query string (min 2 characters). Supports operators: `\"phrase\"`, `-exclude`, `by:author`, `site:domain`, `title:word`.\n"
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "(Required) Comma-separated list of result types to include. Currently supported: `items`. Additional types will be added in future releases.\n"
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter for item results. Restricts results to items with the given status. Comma-separated for multiple. Omit to search all content. Only applies when `items` is in the `type` parameter.\n"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "25",
                  "description": "Number of results per page. Min 1, max 100."
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Opaque cursor for the next page of results, from a previous `next_cursor`."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
