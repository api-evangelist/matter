{
  "opencollection": "1.0.0",
  "info": {
    "name": "Matter Account API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get current account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getmatter.com/public/v1/me"
          },
          "docs": "Returns the authenticated user's account information and rate-limit quota."
        }
      ]
    }
  ],
  "bundled": true
}