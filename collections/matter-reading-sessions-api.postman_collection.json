          "name": "List reading sessions",
          "request": {
            "name": "List reading sessions",
            "description": {
              "content": "Returns a paginated list of reading sessions for the authenticated user,\nordered by date descending (newest first).\n\nEach session records a single reading period with a timestamp and duration.\nUse these to compute reading streaks, daily totals, or other time-based\nstatistics client-side.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "reading_sessions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "since",
                  "value": "<dateTime>",
                  "description": "Only return sessions on or after this ISO 8601 datetime. Useful for incremental sync.\n"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "25",
                  "description": "Number of results per page. Min 1, max 100."
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Opaque cursor for the next page of results, from a previous `next_cursor`."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
